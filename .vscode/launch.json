{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/editors/vscode/llvm-language-server"
			],
			"outFiles": [
				"${workspaceFolder}/editors/vscode/llvm-language-server/out/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		}
	]
}
