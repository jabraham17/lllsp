{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "label": "npm: watch",
      "presentation": {
        "reveal": "never",
      },
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode/llvm-language-server"
      }
    }
    ,
    {
      "type": "npm",
      "script": "make_bundled",
      "group": "build",
      "problemMatcher": [],
      "label": "npm: make_bundled",
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode/llvm-language-server"
      }
    },
    {
      "label": "defaultBuildTask",
      "dependsOn": [
        "npm: watch",
        "npm: make_bundled"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
